---
// 阅读页：GET /workbuddy/[...slug]
// 从 workbuddy 内容集合渲染单篇搬运内容，复用 WorkbuddyLayout（TOC + 进度条 + 前后导航）。
import { render } from 'astro:content';
import WorkbuddyLayout from '../../layouts/WorkbuddyLayout.astro';
import { getWorkbuddy, titleFromEntry } from '../../lib/workbuddy';
import { withBase } from '../../lib/course';

export async function getStaticPaths() {
  const entries = await getWorkbuddy();
  return entries.map((entry, i) => {
    const prev = entries[i - 1];
    const next = entries[i + 1];
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: prev ? { slug: withBase(`/workbuddy/${prev.id}/`), title: titleFromEntry(prev) } : undefined,
        next: next ? { slug: withBase(`/workbuddy/${next.id}/`), title: titleFromEntry(next) } : undefined,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const title = titleFromEntry(entry);
const description = (entry.data.description as string | undefined) || title;

// 目录落地页：蓝皮书各篇总览 + 附录（无图、纯章节链接列表）→ 去除 TOC、居中、毛玻璃渐变
const landing = /^bluebook\/(part\d+|appendix)$/.test(entry.id);
---

<WorkbuddyLayout title={title} description={description} headings={headings} prev={prev} next={next} landing={landing}>
  <Content />
</WorkbuddyLayout>
